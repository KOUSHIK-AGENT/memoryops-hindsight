# Copy to .env (git-ignored) and fill in. Never commit .env.
HINDSIGHT_API_KEY=
# Use a brand-new bank ID for a clean "before memory" demo, e.g. memoryops-final-demo-0928
HINDSIGHT_BANK_ID=memoryops-final-demo
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
PORT=3000
# Optional: append explicitly extracted facts to recall queries (off until evaluation shows it helps)
# MEMORYOPS_NORMALIZE_QUERY=1
# Optional: disable automatic team-pattern consolidation after each confirmed save
# MEMORYOPS_AUTO_CONSOLIDATE=0
